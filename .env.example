# Copy this file to .env and fill in your values.

# Required — from Discord Developer Portal → Your App → Bot
BOT_TOKEN=your_discord_bot_token_here

# Required — your personal Discord user ID (right-click your name → Copy User ID)
MASTER_USER_ID=your_discord_user_id_here

# Strongly recommended — encrypts TOTP secrets at rest.
#
# A TOTP secret IS the authenticator: paste one into any authenticator app and
# it produces that user's codes forever. Without this key those secrets sit in
# database.db as readable text, so a leaked backup or copied volume is enough
# to bypass 2FA for every privileged user.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Existing plaintext secrets are encrypted automatically on the next startup —
# nobody has to re-pair their authenticator.
#
# Back up database.db before setting this, and never change or lose the key
# afterwards — rotating it makes every stored secret unreadable and forces
# every user to re-run /create-2fa.
ENCRYPTION_KEY=

# Optional — pins slash commands to one guild, so they register instantly
# instead of taking up to an hour. Set this when running one instance per
# server; leave empty when one instance serves several servers.
DEBUG_GUILD_ID=

# Optional — override the default database file path (defaults to database.db).
# On Railway/Docker point this INSIDE your mounted volume (e.g. /data/database.db),
# otherwise the database is wiped on every deploy.
DATABASE_PATH=
